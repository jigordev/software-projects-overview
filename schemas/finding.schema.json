{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software Projects Overview Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "code",
    "severity",
    "location",
    "detail",
    "fix",
    "evidence",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^F-[A-Z]+-[0-9]{3,}$"
    },
    "code": {
      "type": "string",
      "pattern": "^(ARC|COD|SIM|MNT|SEC|TST|REL|PER|SCL|DB|OBS|DOC|DEP|OPS|LLM)-[0-9]{2}$"
    },
    "severity": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "S4"
      ]
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "fix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "related_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "status": {
      "enum": [
        "confirmed",
        "needs_verification",
        "accepted_risk",
        "resolved"
      ]
    }
  }
}