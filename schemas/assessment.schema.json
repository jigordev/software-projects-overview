{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software Projects Overview Assessment",
  "type": "object",
  "required": [
    "project",
    "mode",
    "dimensions",
    "findings",
    "limitations"
  ],
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mode": {
      "enum": [
        "full",
        "targeted",
        "incremental",
        "reassessment"
      ]
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "status"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "enum": [
              "assessed",
              "partially_assessed",
              "not_assessed"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "applicable_criteria": {
            "type": "integer",
            "minimum": 0
          },
          "assessed_criteria": {
            "type": "integer",
            "minimum": 0
          },
          "not_applicable_criteria": {
            "type": "integer",
            "minimum": 0
          },
          "not_assessed_criteria": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "overall_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "maturity_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "security_status": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}